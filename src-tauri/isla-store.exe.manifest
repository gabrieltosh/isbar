<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Manifiesto del ejecutable para el paquete de Microsoft Store (MSIX completo).
     Sin el elemento msix: dentro del paquete la identidad la da el propio MSIX.
     Solo ASCII en este archivo: el compilador de recursos estropea los acentos -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="0.1.0.0" name="Isla" />
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*" />
    </dependentAssembly>
  </dependency>
</assembly>
